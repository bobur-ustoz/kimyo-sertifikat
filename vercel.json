{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/keepalive?job=nazorat",
      "schedule": "0 4 * * *"
    }
  ]
}
